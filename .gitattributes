# Set default behavior to normalize all text files to LF on checkout and commit
* text=auto eol=lf

# Explicit text formats (LF)
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.ndjson text eol=lf
*.csv text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
